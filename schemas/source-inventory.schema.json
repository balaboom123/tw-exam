{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed official source scope inventory",
  "type": "object",
  "required": ["schema_version", "inventory_version", "captured_at", "site_id", "providers", "candidates"],
  "properties": {
    "schema_version": {"const": 1},
    "inventory_version": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "minLength": 1},
    "site_id": {"const": "default"},
    "providers": {"type": "array", "items": {"$ref": "#/$defs/provider"}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}}
  },
  "additionalProperties": false,
  "$defs": {
    "availableYears": {
      "type": "object",
      "required": ["mode", "note"],
      "properties": {
        "mode": {"enum": ["observed_range", "current_scope", "unknown"]},
        "start_ad": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2200},
        "end_ad": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2200},
        "note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "discovery": {
      "type": "object",
      "required": ["manifest_path", "status", "coverage"],
      "properties": {
        "manifest_path": {"type": "string", "minLength": 1},
        "status": {"enum": ["present", "missing", "blocked", "not_applicable"]},
        "coverage": {"enum": ["complete", "partial", "unknown"]}
      },
      "additionalProperties": false
    },
    "base": {
      "type": "object",
      "required": ["official_source_urls", "exam_category", "status", "status_reason", "available_years", "restrictions", "evidence"],
      "properties": {
        "official_source_urls": {"type": "array", "items": {"type": "string", "pattern": "^https://"}},
        "source_name": {"type": "string", "minLength": 1},
        "exam_category": {"type": "string", "minLength": 1},
        "status": {"enum": ["covered", "partial", "blocked", "intentionally_out_of_scope"]},
        "status_reason": {"type": "string", "minLength": 1},
        "available_years": {"$ref": "#/$defs/availableYears"},
        "restrictions": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "provider": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "required": ["provider_id", "local_years", "local_state", "discovery_snapshot"],
          "properties": {
            "provider_id": {"type": "string", "minLength": 1},
            "local_years": {"type": "array", "items": {"type": "integer", "minimum": 1900, "maximum": 2200}},
            "local_state": {
              "type": "object",
              "required": ["raw_event_pages", "normalized_paper_records", "sync_failures"],
              "properties": {
                "raw_event_pages": {"type": "integer", "minimum": 0},
                "normalized_paper_records": {"type": "integer", "minimum": 0},
                "sync_failures": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            },
            "discovery_snapshot": {"$ref": "#/$defs/discovery"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "candidate": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "required": ["source_id"],
          "properties": {"source_id": {"type": "string", "minLength": 1}}
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
