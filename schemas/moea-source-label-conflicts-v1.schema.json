{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/moea-source-label-conflicts-v1.schema.json",
  "title": "Reviewed MOEA recruitment source-label conflicts v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "facts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_id": {
      "const": "moea_recruit"
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "year_roc",
          "listing_group",
          "conflict_label",
          "native_files",
          "reviewed_at",
          "reason"
        ],
        "properties": {
          "year_roc": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "listing_group": {
            "type": "string",
            "minLength": 1
          },
          "conflict_label": {
            "type": "string",
            "minLength": 1
          },
          "native_files": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_url",
                "source_label",
                "checksum",
                "native_role",
                "native_subject",
                "inspected_pages"
              ],
              "properties": {
                "source_url": {
                  "type": "string",
                  "pattern": "^https://www\\.taipower\\.com\\.tw/media/[^?#]+\\.pdf(\\?[^#]*)?$"
                },
                "source_label": {
                  "type": "string",
                  "minLength": 1
                },
                "checksum": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "native_role": {
                  "enum": [
                    "question",
                    "answer",
                    "question_answer",
                    "corrected_answer"
                  ]
                },
                "native_subject": {
                  "type": "string",
                  "minLength": 1
                },
                "inspected_pages": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          },
          "reviewed_at": {
            "type": "string",
            "format": "date"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
