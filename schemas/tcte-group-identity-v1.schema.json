{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/tcte-group-identity-v1.schema.json",
  "title": "Reviewed TCTE annual candidate-group meanings v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "reviewed_at",
    "references",
    "annual_sources",
    "tracks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_id": {
      "const": "tcte_tve"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "checksum",
          "pdf_pages",
          "purpose"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "checksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "pdf_pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "annual_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "year_roc",
          "source_exam_id",
          "source_url",
          "checksum"
        ],
        "properties": {
          "year_roc": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "source_exam_id": {
            "type": "string",
            "pattern": "^tcte-tve-[0-9]{1,3}$"
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://web1\\.tcte\\.edu\\.tw/EXAM/[0-9]{3}_4y/$"
          },
          "checksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 1
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind",
          "member_tracks",
          "predecessor_tracks",
          "source_groups",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(tcte-[a-z0-9]+(-[a-z0-9]+)*|common-subject)$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "single",
              "composite",
              "common"
            ]
          },
          "member_tracks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "predecessor_tracks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "source_groups": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category_code",
                "source_label",
                "from_year_roc",
                "through_year_roc"
              ],
              "properties": {
                "category_code": {
                  "type": "string",
                  "pattern": "^([0-9]{2}|common)$"
                },
                "source_label": {
                  "type": "string",
                  "minLength": 1
                },
                "from_year_roc": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 999
                },
                "through_year_roc": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 999
                }
              }
            },
            "minItems": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    }
  }
}
