{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/twc-archive-identity-v1.schema.json",
  "title": "Reviewed Taiwan Water outer-archive date and stage facts v1",
  "type": "object",
  "required": ["schema_version", "provider_id", "facts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "provider_id": {"const": "twc_recruit"},
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["programme_year_roc", "source_url", "checksum", "written_test_date", "evidence_url", "evidence_label", "review_reason", "reviewed_at"],
        "additionalProperties": false,
        "properties": {
          "programme_year_roc": {"type": "integer", "minimum": 1, "maximum": 999},
          "source_url": {"type": "string", "pattern": "^https://www\\.water\\.gov\\.tw/ch/ServerFile/Get/[0-9a-fA-F-]+\\?nodeId=715$"},
          "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "written_test_date": {"type": ["string", "null"], "format": "date"},
          "evidence_url": {"type": "string", "pattern": "^https?://[^/]+"},
          "evidence_label": {"type": "string", "minLength": 1},
          "review_reason": {"type": "string"},
          "reviewed_at": {"type": "string", "format": "date"}
        },
        "allOf": [{
          "if": {"properties": {"written_test_date": {"type": "null"}}},
          "then": {"properties": {"review_reason": {"type": "string", "minLength": 1}}}
        }]
      }
    }
  }
}
