{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/wdasec-native-paper-facts-v2.schema.json",
  "title": "WDA native paper facts with independent grade and file role evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "reviewed_at",
    "review_notes",
    "rules",
    "papers"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "provider_id": {
      "$ref": "wdasec-native-paper-facts-v1.schema.json#/properties/provider_id"
    },
    "reviewed_at": {
      "$ref": "wdasec-native-paper-facts-v1.schema.json#/properties/reviewed_at"
    },
    "review_notes": {
      "$ref": "wdasec-native-paper-facts-v1.schema.json#/properties/review_notes"
    },
    "rules": {
      "$ref": "wdasec-native-paper-facts-v1.schema.json#/properties/rules"
    },
    "papers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "year_roc",
          "source_exam_id",
          "exam_name_raw",
          "category_code",
          "subject_code",
          "subject_name_raw",
          "source_url",
          "checksum",
          "form",
          "native_header"
        ],
        "properties": {
          "year_roc": {
            "$ref": "wdasec-native-paper-facts-v1.schema.json#/properties/papers/items/properties/year_roc"
          },
          "source_exam_id": {
            "$ref": "wdasec-native-paper-facts-v1.schema.json#/properties/papers/items/properties/source_exam_id"
          },
          "exam_name_raw": {
            "$ref": "wdasec-native-paper-facts-v1.schema.json#/properties/papers/items/properties/exam_name_raw"
          },
          "category_code": {
            "$ref": "wdasec-native-paper-facts-v1.schema.json#/properties/papers/items/properties/category_code"
          },
          "subject_code": {
            "$ref": "wdasec-native-paper-facts-v1.schema.json#/properties/papers/items/properties/subject_code"
          },
          "subject_name_raw": {
            "$ref": "wdasec-native-paper-facts-v1.schema.json#/properties/papers/items/properties/subject_name_raw"
          },
          "source_url": {
            "$ref": "wdasec-native-paper-facts-v1.schema.json#/properties/papers/items/properties/source_url"
          },
          "checksum": {
            "$ref": "wdasec-native-paper-facts-v1.schema.json#/properties/papers/items/properties/checksum"
          },
          "form": {
            "$ref": "wdasec-native-paper-facts-v1.schema.json#/properties/papers/items/properties/form"
          },
          "native_header": {
            "$ref": "wdasec-native-paper-facts-v1.schema.json#/properties/papers/items/properties/native_header"
          },
          "reviewed_grade": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level_id",
              "native_grade",
              "subject_label",
              "evidence"
            ],
            "properties": {
              "level_id": {
                "$ref": "wdasec-native-paper-facts-v1.schema.json#/properties/papers/items/properties/reviewed_identity/properties/level_id"
              },
              "native_grade": {
                "$ref": "wdasec-native-paper-facts-v1.schema.json#/properties/papers/items/properties/reviewed_identity/properties/native_grade"
              },
              "subject_label": {
                "$ref": "wdasec-native-paper-facts-v1.schema.json#/properties/papers/items/properties/reviewed_identity/properties/subject_label"
              },
              "evidence": {
                "$ref": "wdasec-native-paper-facts-v1.schema.json#/properties/papers/items/properties/reviewed_identity/properties/evidence"
              }
            }
          },
          "reviewed_role": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file_role",
              "evidence"
            ],
            "properties": {
              "file_role": {
                "$ref": "wdasec-native-paper-facts-v1.schema.json#/properties/papers/items/properties/reviewed_identity/properties/file_role"
              },
              "evidence": {
                "$ref": "wdasec-native-paper-facts-v1.schema.json#/properties/papers/items/properties/reviewed_identity/properties/evidence"
              },
              "question_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              }
            }
          }
        }
      }
    }
  }
}
