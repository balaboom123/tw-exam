{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/moex-native-question-references-v1.schema.json",
  "title": "Reviewed MOEX native question reference corrections v1",
  "allOf": [
    {
      "$ref": "https://tw-exam.invalid/schemas/native-file-role-reviews-v1.schema.json"
    },
    {
      "properties": {
        "provider_id": {
          "const": "moex"
        },
        "facts": {
          "items": {
            "properties": {
              "source_exam_id": {
                "type": "string",
                "pattern": "^[0-9]{6}$"
              },
              "category_code": {
                "type": "string",
                "pattern": "^[0-9]{3}$"
              },
              "subject_code": {
                "type": "string",
                "pattern": "^[a-z][0-9]{3}$"
              },
              "source_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://wwwq\\.moex\\.gov\\.tw/exam/wHandExamQandA_File\\.ashx\\?"
              }
            }
          }
        }
      }
    }
  ]
}
