{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/twc-archive-papers-v1.schema.json",
  "title": "Reviewed Taiwan Water native paper inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider_id", "archives"],
  "properties": {
    "schema_version": {"const": 1},
    "provider_id": {"const": "twc_recruit"},
    "archives": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/archive"}
    }
  },
  "$defs": {
    "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "categoryId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_id", "label", "track_id", "native_categories", "variants", "evidence_url", "evidence_label", "review_reason"],
      "properties": {
        "category_id": {"$ref": "#/$defs/categoryId"},
        "label": {"type": "string", "minLength": 1},
        "track_id": {"type": "string", "pattern": "^twc-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "native_categories": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "variants": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": {"$ref": "#/$defs/categoryId"},
              "label": {"type": "string", "minLength": 1}
            }
          }
        },
        "evidence_url": {"type": "string", "format": "uri"},
        "evidence_label": {"type": "string", "minLength": 1},
        "review_reason": {"type": "string"}
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_name", "checksum", "file_role", "subject_label",
        "native_category_header", "revision_notice"
      ],
      "properties": {
        "native_name": {"type": "string", "minLength": 1},
        "checksum": {"$ref": "#/$defs/checksum"},
        "file_role": {"enum": ["question", "answer", "question_answer", "source_artifact"]},
        "subject_label": {"type": "string"},
        "native_category_header": {"type": "string"},
        "revision_notice": {"type": "string"},
        "category_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/categoryId"}
        },
        "paper_slot": {"enum": ["", "common", "professional-1", "professional-2"]}
      },
      "allOf": [{
        "if": {"properties": {"file_role": {"const": "source_artifact"}}},
        "then": {
          "properties": {
            "subject_label": {"const": ""},
            "native_category_header": {"const": ""},
            "revision_notice": {"const": ""},
            "category_ids": {"maxItems": 0},
            "paper_slot": {"const": ""}
          }
        },
        "else": {
          "properties": {
            "subject_label": {"minLength": 1},
            "native_category_header": {"minLength": 1}
          }
        }
      }]
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "programme_year_roc", "source_url", "checksum", "reviewed_at",
        "review_reason", "members"
      ],
      "properties": {
        "programme_year_roc": {"type": "integer", "minimum": 1, "maximum": 999},
        "source_url": {"type": "string", "format": "uri"},
        "checksum": {"$ref": "#/$defs/checksum"},
        "reviewed_at": {"type": "string", "format": "date"},
        "review_reason": {"type": "string"},
        "members": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/member"}
        },
        "categories": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/category"}
        }
      },
      "allOf": [{
        "if": {"properties": {"review_reason": {"const": ""}}},
        "then": {"properties": {"members": {"minItems": 1}}},
        "else": {"properties": {"members": {"maxItems": 0}, "review_reason": {"minLength": 1}}}
      }]
    }
  }
}
