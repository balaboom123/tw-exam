{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/taisugar-annual-written-exams-v1.schema.json",
  "title": "Taiwan Sugar exact annual written-stage evidence v1",
  "type": "object",
  "required": [
    "schema_version",
    "provider_id",
    "facts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_id": {
      "const": "taisugar_recruit"
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "year_roc",
          "source_exam_id",
          "subject_code",
          "title",
          "source_url",
          "checksum",
          "exam_name_raw",
          "rule_title",
          "rule_url",
          "rule_checksum",
          "rule_publication_date",
          "written_test_date",
          "rule_pdf_pages",
          "reviewed_at",
          "reason"
        ],
        "properties": {
          "year_roc": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "source_exam_id": {
            "type": "string",
            "pattern": "^taisugar-recruit-[0-9]{1,3}$"
          },
          "subject_code": {
            "type": "string",
            "pattern": "^taisugar-file-[0-9a-f]{16}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://www\\.taisugar\\.com\\.tw/upload/(UserFiles|RelFile)/News/[0-9]+/[^/?#]+\\.pdf$"
          },
          "checksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "exam_name_raw": {
            "type": "string",
            "minLength": 1
          },
          "rule_title": {
            "type": "string",
            "minLength": 1
          },
          "rule_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://www\\.taisugar\\.com\\.tw/upload/(UserFiles|RelFile)/News/[0-9]+/[^/?#]+\\.pdf$"
          },
          "rule_checksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rule_publication_date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "written_test_date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "rule_pdf_pages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "reviewed_at": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
