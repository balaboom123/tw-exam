{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/native-file-role-reviews-v1.schema.json",
  "title": "Shared exact source anchors for native file-role reviews v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "facts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourceAnchor",
        "unevaluatedProperties": false
      }
    }
  },
  "$defs": {
    "sourceAnchor": {
      "type": "object",
      "required": [
        "source_exam_id",
        "year_roc",
        "category_code",
        "subject_code",
        "title",
        "source_url",
        "checksum",
        "native_page",
        "reviewed_at",
        "reason"
      ],
      "properties": {
        "source_exam_id": {
          "type": "string",
          "minLength": 1
        },
        "category_code": {
          "type": "string",
          "minLength": 1
        },
        "subject_code": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "checksum": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "native_page": {
          "type": "integer",
          "minimum": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "year_roc": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        }
      }
    }
  }
}
