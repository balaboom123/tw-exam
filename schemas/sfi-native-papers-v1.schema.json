{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/sfi-native-papers-v1.schema.json",
  "title": "Reviewed SFI native paper contexts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "evidence_url",
    "facts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_id": {
      "const": "sfi_cert"
    },
    "evidence_url": {
      "const": "https://www.sfi.org.tw/Node?id=217"
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "checksum",
          "category_code",
          "programme_slug",
          "year_roc",
          "round_no",
          "venue",
          "file_type",
          "subjects",
          "source_urls",
          "native_heading",
          "reviewed_at",
          "inspected_header_pages",
          "page_count"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^sfi-native-[0-9a-f]{20}$"
          },
          "checksum": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          },
          "category_code": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9]{2}$"
          },
          "programme_slug": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "native_heading": {
            "type": "string",
            "minLength": 1
          },
          "year_roc": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "round_no": {
            "type": "integer",
            "minimum": 1
          },
          "venue": {
            "enum": [
              "",
              "kaohsiung"
            ]
          },
          "file_type": {
            "enum": [
              "question",
              "answer"
            ]
          },
          "subjects": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://examweb\\.sfi\\.org\\.tw/Download/(01|02)/[0-9]{2}a?\\.[pP][dD][fF]$"
            }
          },
          "reviewed_at": {
            "type": "string",
            "format": "date"
          },
          "inspected_header_pages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "page_count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
