{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/cmu-annual-papers-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "references",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_id": {
      "const": "hce_cmu"
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "year_roc",
          "kind",
          "source_url",
          "checksum",
          "pdf_pages",
          "finding"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "year_roc": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "kind": {
            "enum": [
              "annual_interview_notice",
              "annual_admission_guide",
              "historical_context"
            ]
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "checksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "pdf_pages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "finding": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "year_roc",
          "source_exam_id",
          "stage_id",
          "reviewed_at",
          "reason",
          "evidence_ids",
          "files"
        ],
        "properties": {
          "year_roc": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "source_exam_id": {
            "type": "string",
            "minLength": 1
          },
          "stage_id": {
            "enum": [
              "stage-1",
              "unknown"
            ]
          },
          "reviewed_at": {
            "type": "string",
            "format": "date"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subject_code",
                "subject_name_raw",
                "file_type",
                "source_url",
                "checksum"
              ],
              "properties": {
                "subject_code": {
                  "type": "string",
                  "minLength": 1
                },
                "subject_name_raw": {
                  "type": "string",
                  "minLength": 1
                },
                "file_type": {
                  "enum": [
                    "question",
                    "answer",
                    "all_answers",
                    "answer_clarification"
                  ]
                },
                "source_url": {
                  "type": "string",
                  "format": "uri"
                },
                "checksum": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
