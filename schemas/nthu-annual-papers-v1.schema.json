{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/nthu-annual-papers-v1.schema.json",
  "title": "Reviewed NTHU annual selection rules and native paper applicability v1",
  "type": "object",
  "required": [
    "schema_version",
    "provider_id",
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_id": {
      "const": "hce_nthu"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "year_roc",
          "source_exam_id",
          "written_test_date",
          "stage_id",
          "rule_url",
          "rule_checksum",
          "rule_printed_pages",
          "reviewed_at",
          "groups",
          "files"
        ],
        "additionalProperties": false,
        "properties": {
          "year_roc": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "source_exam_id": {
            "type": "string",
            "pattern": "^hce-nthu-[0-9]{1,3}$"
          },
          "written_test_date": {
            "type": "string",
            "format": "date"
          },
          "stage_id": {
            "const": "stage-1"
          },
          "rule_url": {
            "type": "string",
            "pattern": "^https://adms\\.site\\.nthu\\.edu\\.tw/[^#]+$"
          },
          "rule_checksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rule_printed_pages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "reviewed_at": {
            "type": "string",
            "format": "date"
          },
          "groups": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "category_code",
                "track_id",
                "label",
                "subjects"
              ],
              "additionalProperties": false,
              "properties": {
                "category_code": {
                  "type": "string",
                  "pattern": "^post-bacc-medicine(?:-[a-z0-9-]+)?$"
                },
                "track_id": {
                  "type": "string",
                  "pattern": "^hce-nthu(?:-[a-z0-9-]+)?$"
                },
                "label": {
                  "type": "string"
                },
                "subjects": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  }
                }
              }
            }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "subject_code",
                "subject_name_raw",
                "file_type",
                "source_url",
                "checksum"
              ],
              "additionalProperties": false,
              "properties": {
                "subject_code": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "subject_name_raw": {
                  "type": "string",
                  "minLength": 1
                },
                "file_type": {
                  "enum": [
                    "question",
                    "all_answers",
                    "answer_clarification"
                  ]
                },
                "source_url": {
                  "type": "string",
                  "pattern": "^https://adms\\.site\\.nthu\\.edu\\.tw/[^#]+$"
                },
                "checksum": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
