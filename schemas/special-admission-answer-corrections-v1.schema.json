{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/special-admission-answer-corrections-v1.schema.json",
  "title": "Reviewed disability university admission native answer corrections v1",
  "allOf": [
    {
      "$ref": "https://tw-exam.invalid/schemas/native-file-role-reviews-v1.schema.json"
    },
    {
      "properties": {
        "provider_id": {
          "const": "special_admission"
        },
        "facts": {
          "items": {
            "properties": {
              "source_exam_id": {
                "type": "string",
                "pattern": "^special-admission-[0-9]{1,3}$"
              },
              "category_code": {
                "const": "university-common"
              },
              "subject_code": {
                "type": "string",
                "pattern": "^[a-z]+(-[a-z]+)*$"
              },
              "source_url": {
                "type": "string",
                "pattern": "^https://cis\\.ncu\\.edu\\.tw/EnableSys/home/readExamInfoFile\\?examInfoId=[0-9]+&row=1$"
              }
            }
          }
        }
      }
    }
  ]
}
