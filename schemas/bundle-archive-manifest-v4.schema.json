{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/bundle-archive-manifest-v4.schema.json",
  "title": "Material-aware source-complete embedded archive manifest",
  "type": "object",
  "required": [
    "manifest_version",
    "schema_version",
    "bundle_id",
    "canonical_id",
    "canonical_name",
    "years",
    "file_count",
    "papers",
    "source_material"
  ],
  "properties": {
    "manifest_version": {
      "const": 4
    },
    "schema_version": {
      "const": 3
    },
    "bundle_id": {
      "type": "string"
    },
    "canonical_id": {
      "type": "string"
    },
    "canonical_name": {
      "type": "string"
    },
    "years": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "uniqueItems": true
    },
    "file_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Physical payload count excluding bundle.json; multiple source records may reference one entry."
    },
    "part_index": {
      "type": "integer",
      "minimum": 1
    },
    "part_count": {
      "type": "integer",
      "minimum": 1
    },
    "part_label": {
      "type": "string"
    },
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_exam_id",
          "category_code",
          "subject_code",
          "file_type",
          "checksum",
          "bundle_entry",
          "year_roc",
          "download_url_source",
          "source_material"
        ],
        "properties": {
          "source_exam_id": {
            "type": "string"
          },
          "category_code": {
            "type": "string"
          },
          "subject_code": {
            "type": "string"
          },
          "file_type": {
            "type": "string"
          },
          "checksum": {
            "type": "string"
          },
          "bundle_entry": {
            "type": "string",
            "minLength": 1
          },
          "year_roc": {
            "type": "integer",
            "minimum": 1
          },
          "download_url_source": {
            "type": "string"
          },
          "source_material": {
            "$ref": "source-material-v1.schema.json#/$defs/material"
          }
        },
        "additionalProperties": false
      }
    },
    "source_material": {
      "$ref": "source-material-v1.schema.json#/$defs/summary"
    }
  }
}
