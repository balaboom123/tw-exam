{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/tqc-sample-identity-v1.schema.json",
  "title": "Reviewed TQC sample subject, content version and native grade coverage",
  "type": "object",
  "required": ["schema_version", "catalog_version", "provider_id", "owner", "programme", "levels", "subjects", "facts"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_version": {"const": "exam-identity-v2"},
    "provider_id": {"const": "tqc_cert"},
    "owner": {"$ref": "#/$defs/text"},
    "programme": {
      "type": "object",
      "required": ["domain_id", "exam_family_id", "id", "label", "evidence_url", "reason"],
      "properties": {
        "domain_id": {"const": "certification"},
        "exam_family_id": {"const": "skill-certification"},
        "id": {"const": "tqc-skills-certification"},
        "label": {"$ref": "#/$defs/text"},
        "evidence_url": {"$ref": "#/$defs/official_url"},
        "reason": {"$ref": "#/$defs/text"}
      },
      "additionalProperties": false
    },
    "levels": {
      "type": "object",
      "required": ["tqc-professional", "tqc-input-performance-grades"],
      "properties": {
        "tqc-professional": {"$ref": "#/$defs/label_reason"},
        "tqc-input-performance-grades": {"$ref": "#/$defs/label_reason"}
      },
      "additionalProperties": false
    },
    "subjects": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"type": "string", "pattern": "^tqc-[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "additionalProperties": {
        "type": "object",
        "required": ["label", "evidence_url"],
        "properties": {
          "label": {"$ref": "#/$defs/text"},
          "evidence_url": {"$ref": "#/$defs/official_url"}
        },
        "additionalProperties": false
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "track_id", "level_id", "variants", "source_url", "checksum", "reviewed_at", "reason"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "title": {"$ref": "#/$defs/text"},
          "track_id": {"$ref": "#/$defs/id"},
          "level_id": {"enum": ["tqc-professional", "tqc-input-performance-grades"]},
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label"],
              "properties": {
                "id": {"$ref": "#/$defs/id"},
                "label": {"$ref": "#/$defs/text"}
              },
              "additionalProperties": false
            }
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://(?:www\\.)?tqc\\.org\\.tw/user/Example/[^?#]+\\.pdf$"
          },
          "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "reviewed_at": {"type": "string", "format": "date"},
          "reason": {"$ref": "#/$defs/text"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "official_url": {"type": "string", "format": "uri", "pattern": "^https://www\\.tqc\\.org\\.tw/TQCNet/"},
    "label_reason": {
      "type": "object",
      "required": ["label", "reason"],
      "properties": {
        "label": {"$ref": "#/$defs/text"},
        "reason": {"$ref": "#/$defs/text"}
      },
      "additionalProperties": false
    }
  }
}
