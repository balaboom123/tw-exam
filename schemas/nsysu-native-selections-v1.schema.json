{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/nsysu-native-selections-v1.schema.json",
  "title": "Reviewed NSYSU native annual documents and subject selections",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_id": {
      "const": "hce_nsysu"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "year_roc",
          "source_exam_id",
          "written_test_date",
          "stage_id",
          "reviewed_at",
          "rule_evidence",
          "groups",
          "active_parent_checksum",
          "documents"
        ],
        "properties": {
          "year_roc": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "source_exam_id": {
            "type": "string",
            "pattern": "^hce-nsysu-[0-9]+$"
          },
          "written_test_date": {
            "type": "string",
            "format": "date"
          },
          "stage_id": {
            "const": "stage-1"
          },
          "reviewed_at": {
            "type": "string",
            "format": "date"
          },
          "rule_evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "checksum",
                "kind",
                "PDF_pages",
                "label"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "checksum": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "kind": {
                  "enum": [
                    "html",
                    "pdf"
                  ]
                },
                "PDF_pages": {
                  "type": "array",
                  "minItems": 0,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "groups": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category_code",
                "track_id",
                "label",
                "subjects"
              ],
              "properties": {
                "category_code": {
                  "type": "string",
                  "pattern": "^post-bacc-medicine(?:-[a-z0-9-]+)?$"
                },
                "track_id": {
                  "type": "string",
                  "pattern": "^hce-nsysu(?:-[a-z0-9-]+)?$"
                },
                "label": {
                  "type": "string"
                },
                "subjects": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                  }
                }
              }
            }
          },
          "active_parent_checksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "documents": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_url",
                "checksum",
                "bytes",
                "page_count",
                "selections"
              ],
              "properties": {
                "source_url": {
                  "type": "string",
                  "format": "uri"
                },
                "checksum": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "page_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "selections": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "subject_code",
                      "subject_name_raw",
                      "file_type",
                      "pages",
                      "checksum",
                      "bytes"
                    ],
                    "properties": {
                      "subject_code": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                      },
                      "subject_name_raw": {
                        "type": "string",
                        "minLength": 1
                      },
                      "file_type": {
                        "enum": [
                          "question",
                          "question_answer",
                          "all_answers"
                        ]
                      },
                      "pages": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "checksum": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 104857600
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
