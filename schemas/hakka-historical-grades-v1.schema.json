{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/hakka-historical-grades-v1.schema.json",
  "title": "Reviewed Hakka historical grade evidence v1",
  "type": "object",
  "required": ["schema_version", "provider_id", "catalog_version", "facts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "provider_id": {"const": "hakka_cert"},
    "catalog_version": {"const": "exam-identity-v2"},
    "facts": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "reviewed_at", "title", "source_url", "subject_code", "checksum", "edition_year_ad", "dialect_code", "level_id", "matching_source_url", "matching_title", "matching_checksum", "matching_subject_code", "reason", "evidence_url"],
        "properties": {
          "id": {"type": "string", "pattern": "^hakka-historical-grade-[a-z0-9-]+$"},
          "reviewed_at": {"type": "string", "format": "date"},
          "title": {"type": "string", "minLength": 1},
          "source_url": {"$ref": "#/$defs/official_ods"},
          "subject_code": {"type": "string", "pattern": "^[0-9]+-[0-9]{3}-excel$"},
          "checksum": {"$ref": "#/$defs/checksum"},
          "edition_year_ad": {"type": "integer", "minimum": 2023, "maximum": 2100},
          "dialect_code": {"enum": ["sixian", "hailu", "dapu", "raoping", "zhaoan"]},
          "level_id": {"const": "basic-elementary"},
          "matching_source_url": {"$ref": "#/$defs/official_ods"},
          "matching_title": {"type": "string", "minLength": 1},
          "matching_checksum": {"$ref": "#/$defs/checksum"},
          "matching_subject_code": {"type": "string", "pattern": "^[0-9]+-[0-9]{3}-excel$"},
          "reason": {"type": "string", "minLength": 1},
          "evidence_url": {"const": "https://elearning.hakka.gov.tw/hakka/download-files?c=2"}
        }
      }
    }
  },
  "$defs": {
    "official_ods": {"type": "string", "pattern": "^https://elearning\\.hakka\\.gov\\.tw/hakka/files/downloads/[0-9]+\\.ods$"},
    "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
