{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/hakka-native-conflicts-v1.schema.json",
  "title": "Reviewed Hakka native source conflicts v1",
  "type": "object",
  "required": ["schema_version", "provider_id", "catalog_version", "facts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "provider_id": {"const": "hakka_cert"},
    "catalog_version": {"const": "exam-identity-v2"},
    "facts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "reviewed_at", "title", "source_url", "subject_code", "checksum", "matching_source_url", "matching_title", "reason", "evidence_url"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^hakka-[a-z0-9-]+$"},
          "reviewed_at": {"type": "string", "format": "date"},
          "title": {"type": "string", "minLength": 1},
          "source_url": {"$ref": "#/$defs/official_asset"},
          "subject_code": {"type": "string", "pattern": "^[0-9]+-[a-z0-9-]+$"},
          "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "matching_source_url": {"$ref": "#/$defs/official_asset"},
          "matching_title": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "evidence_url": {"const": "https://elearning.hakka.gov.tw/hakka/download-files?c=2"}
        }
      }
    }
  },
  "$defs": {
    "official_asset": {"type": "string", "pattern": "^https://elearning\\.hakka\\.gov\\.tw/hakka/files/downloads/[0-9]+\\.(ods|zip)$"}
  }
}
