{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/taisugar-annual-written-exams-v2.schema.json",
  "title": "Taiwan Sugar annual written-stage evidence v2",
  "type": "object",
  "required": [
    "schema_version",
    "provider_id",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "provider_id": {
      "const": "taisugar_recruit"
    },
    "events": {
      "type": "array",
      "description": "Primary rule groups with disjoint native paper slots. A retained source event may contain several independently governed programmes in the same year; rule URLs and paper contexts must be unique across groups, enforced by annual.py.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "year_roc",
          "source_exam_id",
          "exam_name_raw",
          "rule_title",
          "rule_url",
          "rule_checksum",
          "rule_publication_date",
          "written_test_date",
          "rule_pdf_pages",
          "reviewed_at",
          "reason",
          "rule_revision_date",
          "papers"
        ],
        "properties": {
          "year_roc": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "source_exam_id": {
            "type": "string",
            "pattern": "^taisugar-recruit-[0-9]{1,3}$"
          },
          "exam_name_raw": {
            "type": "string",
            "minLength": 1
          },
          "rule_title": {
            "type": "string",
            "minLength": 1
          },
          "rule_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://www\\.taisugar\\.com\\.tw/upload/(UserFiles|RelFile)/News/[0-9]+/[^/?#]+\\.pdf$"
          },
          "rule_checksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rule_publication_date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "written_test_date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "rule_pdf_pages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "reviewed_at": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "rule_revision_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Printed revision date of the reviewed rule edition; independent of the sitting date."
          },
          "papers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "subject_code",
                "title",
                "source_url",
                "checksum"
              ],
              "properties": {
                "subject_code": {
                  "type": "string",
                  "pattern": "^taisugar-(file|member)-[0-9a-f]{16}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "source_url": {
                  "type": "string",
                  "format": "uri",
                  "anyOf": [
                    {
                      "pattern": "^https://www\\.taisugar\\.com\\.tw/upload/UserFiles/News/[0-9]+/[^/?#]+\\.[pP][dD][fF]$"
                    },
                    {
                      "pattern": "^https://www\\.taisugar\\.com\\.tw/upload/UserFiles/News/[0-9]+/[^/?#]+\\.[zZ][iI][pP]#archive-sha256=[0-9a-f]{64}&member=.+$"
                    }
                  ]
                },
                "checksum": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
