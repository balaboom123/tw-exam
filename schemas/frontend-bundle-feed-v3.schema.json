{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/frontend-bundle-feed-v3.schema.json",
  "title": "Frontend bundle feed v3 with reviewed material and dates",
  "type": "object",
  "required": [
    "schema_version",
    "site_id",
    "catalog_version",
    "bundles"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "catalog_version": {
      "const": "exam-identity-v2"
    },
    "bundles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bundle"
      },
      "contains": {
        "required": [
          "sourceMaterial"
        ]
      }
    }
  },
  "$defs": {
    "bundle": {
      "type": "object",
      "required": [
        "id",
        "name",
        "years",
        "fileCount",
        "url",
        "domainId",
        "examFamilyId",
        "seriesId",
        "levelId",
        "trackId",
        "variantIds",
        "stageId",
        "examClass",
        "examSubclass",
        "searchAliases"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "years": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "fileCount": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string"
        },
        "domainId": {
          "type": "string"
        },
        "examFamilyId": {
          "type": "string"
        },
        "seriesId": {
          "type": "string"
        },
        "levelId": {
          "type": "string"
        },
        "trackId": {
          "type": "string"
        },
        "variantIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stageId": {
          "type": "string"
        },
        "examClass": {
          "type": "string"
        },
        "examSubclass": {
          "type": "string"
        },
        "searchAliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subjectLabels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "updated": {
          "type": "string",
          "format": "date-time"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "url"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              }
            },
            "additionalProperties": false
          }
        },
        "sourceMaterial": {
          "$ref": "source-material-v1.schema.json#/$defs/summary"
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label",
              "url",
              "fileCount"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string"
              },
              "fileCount": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "not": {
              "required": ["sourceMaterial"]
            }
          },
          "then": {
            "properties": {
              "years": {"minItems": 1}
            }
          }
        }
      ]
    }
  }
}
