{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/tcte-answer-corrections-v1.schema.json",
  "title": "Reviewed TCTE native mathematics answer corrections v1",
  "allOf": [
    {
      "$ref": "https://tw-exam.invalid/schemas/native-file-role-reviews-v1.schema.json"
    },
    {
      "properties": {
        "provider_id": {
          "const": "tcte_tve"
        },
        "facts": {
          "items": {
            "properties": {
              "source_exam_id": {
                "type": "string",
                "pattern": "^tcte-tve-[0-9]{1,3}$"
              },
              "category_code": {
                "const": "common"
              },
              "subject_code": {
                "type": "string",
                "pattern": "^math-[abc]$"
              },
              "source_url": {
                "type": "string",
                "pattern": "^https://web1\\.tcte\\.edu\\.tw/EXAM/[0-9]{3}_4y/downloader\\.php\\?obj=[A-Za-z0-9+/=]+$"
              }
            }
          }
        }
      }
    }
  ]
}
