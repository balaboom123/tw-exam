{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/newtaipei-native-archives-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "archives"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "provider_id": {
      "const": "teacher_recruit_newtaipei"
    },
    "archives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_exam_id",
          "year_roc",
          "programme_name",
          "source_url",
          "checksum",
          "size",
          "reviewed_at",
          "review_notes",
          "members"
        ],
        "properties": {
          "source_exam_id": {
            "type": "string",
            "pattern": "^teacher-recruit-newtaipei-[0-9]{1,3}-junior$"
          },
          "year_roc": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "programme_name": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://career[.]ntpc[.]edu[.]tw/web-elec-bulletin/open/oauth_data/op_api/download/[0-9a-f]{31,32}$"
          },
          "checksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 104857600
          },
          "reviewed_at": {
            "type": "string",
            "format": "date"
          },
          "review_notes": {
            "type": "string",
            "minLength": 1
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "kind",
                "size",
                "checksum",
                "subject_name",
                "file_type",
                "native_header",
                "page_count",
                "inspected_pages"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "file",
                    "directory"
                  ]
                },
                "size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 26214400
                },
                "checksum": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{64})?$"
                },
                "subject_name": {
                  "type": "string"
                },
                "file_type": {
                  "enum": [
                    "",
                    "question",
                    "answer",
                    "source_document"
                  ]
                },
                "native_header": {
                  "type": "string"
                },
                "page_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "inspected_pages": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
