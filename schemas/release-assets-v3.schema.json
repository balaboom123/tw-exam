{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/release-assets-v3.schema.json",
  "title": "Primary assets and explicit frozen historical downloads",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site_id",
    "catalog_version",
    "assets",
    "retained_downloads"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "catalog_version": {
      "const": "exam-identity-v2"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "release-assets-v2.schema.json#/$defs/asset"
      }
    },
    "retained_downloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "retained-downloads-v1.schema.json#/$defs/download"
      }
    }
  }
}
