{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/tcte-shared-booklets-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "provider_id",
    "facts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_id": {
      "const": "tcte_tve"
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "year_roc",
          "source_exam_id",
          "exam_name_raw",
          "category_code",
          "category_raw",
          "source_url",
          "checksum",
          "page_count",
          "inspected_pages",
          "common_pages",
          "members",
          "reviewed_at",
          "reason"
        ],
        "properties": {
          "year_roc": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "source_exam_id": {
            "type": "string",
            "minLength": 1
          },
          "exam_name_raw": {
            "type": "string",
            "minLength": 1
          },
          "category_code": {
            "const": "common"
          },
          "category_raw": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "checksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "page_count": {
            "type": "integer",
            "minimum": 1
          },
          "inspected_pages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "common_pages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "members": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "form",
                "first_page",
                "last_page"
              ],
              "properties": {
                "form": {
                  "type": "string",
                  "pattern": "^[A-Z]$"
                },
                "first_page": {
                  "type": "integer",
                  "minimum": 1
                },
                "last_page": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "reviewed_at": {
            "type": "string",
            "format": "date"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
