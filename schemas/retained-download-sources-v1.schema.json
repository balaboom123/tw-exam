{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/retained-download-sources-v1.schema.json",
  "title": "Source papers of each frozen historical download, recorded once from verified bytes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "site_id", "archives"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "site_id": {"type": "string", "minLength": 1},
    "archives": {
      "type": "object",
      "propertyNames": {"pattern": "^[^/\\\\]+\\.zip$"},
      "additionalProperties": {"$ref": "#/$defs/archive"}
    }
  },
  "$defs": {
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checksum", "canonical_name", "papers"],
      "properties": {
        "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "canonical_name": {"type": "string", "minLength": 1},
        "papers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/paper"}}
      }
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year_roc", "source_exam_id", "category_code", "subject_code",
        "file_type", "download_url_source", "checksum"
      ],
      "properties": {
        "year_roc": {"type": "integer", "minimum": 0},
        "source_exam_id": {"type": "string"},
        "category_code": {"type": "string"},
        "subject_code": {"type": "string"},
        "file_type": {"type": "string"},
        "download_url_source": {"type": "string"},
        "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
