{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "events"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "provider_id": {
      "const": "teacher_recruit_taoyuan_elementary"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "year_roc",
          "source_exam_id",
          "programme_name",
          "rule_title",
          "rule_url",
          "rule_checksum",
          "rule_publication_date",
          "written_test_date",
          "stage_id",
          "rule_page_count",
          "rule_inspected_pages",
          "notice_urls",
          "reviewed_at",
          "review_notes",
          "jobs",
          "files"
        ],
        "properties": {
          "year_roc": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "source_exam_id": {
            "type": "string",
            "pattern": "^teacher-recruit-taoyuan-elementary-[0-9]+$"
          },
          "programme_name": {
            "type": "string",
            "minLength": 1
          },
          "rule_title": {
            "type": "string",
            "minLength": 1
          },
          "rule_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://elementary\\.tyc\\.edu\\.tw/web/download_file\\.aspx\\?ids=[0-9a-f]{31,32}(&openExternalBrowser=1)?$"
          },
          "rule_checksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rule_publication_date": {
            "type": "string",
            "format": "date"
          },
          "written_test_date": {
            "type": "string",
            "format": "date"
          },
          "stage_id": {
            "const": "stage-1"
          },
          "rule_page_count": {
            "type": "integer",
            "minimum": 1
          },
          "rule_inspected_pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "notice_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://elementary\\.tyc\\.edu\\.tw/web/news-info\\.aspx\\?id=[0-9a-f]{31,32}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "reviewed_at": {
            "type": "string",
            "format": "date"
          },
          "review_notes": {
            "type": "string",
            "minLength": 1
          },
          "jobs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category_code",
                "label",
                "track_id",
                "eligibility_note",
                "booklets"
              ],
              "properties": {
                "category_code": {
                  "type": "string",
                  "pattern": "^[0-9]{2}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "track_id": {
                  "type": "string",
                  "pattern": "^taoyuan-elementary-[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "eligibility_note": {
                  "type": "string",
                  "minLength": 1
                },
                "booklets": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "subject_code",
                      "weight"
                    ],
                    "properties": {
                      "subject_code": {
                        "type": "string",
                        "pattern": "^subject-[0-9a-f]{8}$"
                      },
                      "weight": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 99
                      }
                    }
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "uniqueItems": true
                }
              }
            },
            "minItems": 1
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subject_code",
                "subject_name_raw",
                "file_type",
                "source_url",
                "checksum",
                "native_header",
                "page_count",
                "inspected_pages"
              ],
              "properties": {
                "subject_code": {
                  "type": "string",
                  "pattern": "^subject-[0-9a-f]{8}$"
                },
                "subject_name_raw": {
                  "type": "string",
                  "minLength": 1
                },
                "file_type": {
                  "enum": [
                    "question",
                    "answer",
                    "corrected_answer"
                  ]
                },
                "source_url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://elementary\\.tyc\\.edu\\.tw/web/download_file\\.aspx\\?ids=[0-9a-f]{31,32}(&openExternalBrowser=1)?$"
                },
                "checksum": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "native_header": {
                  "type": "string",
                  "minLength": 1
                },
                "page_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "inspected_pages": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              }
            },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/taoyuan-elementary-native-papers-v1.schema.json",
  "title": "Reviewed Taoyuan elementary recruitment categories and shared native papers"
}
