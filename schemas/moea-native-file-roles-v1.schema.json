{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/moea-native-file-roles-v1.schema.json",
  "title": "Exact reviewed MOEA native file roles v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "facts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_id": {
      "const": "moea_recruit"
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_exam_id",
          "year_roc",
          "category_code",
          "category_raw",
          "subject_code",
          "title",
          "source_url",
          "checksum",
          "source_role",
          "native_role",
          "native_subject",
          "inspected_pages",
          "reviewed_at",
          "native_correction_date",
          "reason"
        ],
        "properties": {
          "source_exam_id": {
            "type": "string",
            "pattern": "^moea-recruit-[0-9]{2,3}$"
          },
          "year_roc": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "category_code": {
            "type": "string",
            "pattern": "^[0-9]{2,3}$"
          },
          "category_raw": {
            "type": "string",
            "minLength": 1
          },
          "subject_code": {
            "type": "string",
            "pattern": "^joint-[0-9a-f]{16}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://www\\.taipower\\.com\\.tw/media/[^?#]+\\.pdf(\\?[^#]*)?$"
          },
          "checksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_role": {
            "enum": [
              "question",
              "answer",
              "question_answer",
              "corrected_answer"
            ]
          },
          "native_role": {
            "enum": [
              "question",
              "answer",
              "question_answer",
              "corrected_answer"
            ]
          },
          "native_subject": {
            "type": "string",
            "minLength": 1
          },
          "inspected_pages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "reviewed_at": {
            "type": "string",
            "format": "date"
          },
          "native_correction_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
