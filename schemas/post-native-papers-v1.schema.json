{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "events"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "provider_id": {
      "const": "post_recruit"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "programme_year_roc",
          "source_exam_id",
          "programme_name",
          "exam_series_id",
          "written_test_date",
          "stage_id",
          "rule_urls",
          "reviewed_at",
          "review_notes",
          "jobs",
          "files"
        ],
        "properties": {
          "programme_year_roc": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "source_exam_id": {
            "type": "string",
            "pattern": "^post-recruit-[0-9]+$"
          },
          "programme_name": {
            "type": "string",
            "minLength": 1
          },
          "exam_series_id": {
            "enum": [
              "postal-recruitment",
              "postal-information-recruitment"
            ]
          },
          "written_test_date": {
            "type": "string",
            "format": "date"
          },
          "stage_id": {
            "const": "stage-1"
          },
          "rule_urls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://(svc\\.tabf\\.org\\.tw|www\\.post\\.gov\\.tw|www\\.motc\\.gov\\.tw|www\\.cna\\.com\\.tw)/"
            },
            "uniqueItems": true
          },
          "reviewed_at": {
            "type": "string",
            "format": "date"
          },
          "review_notes": {
            "type": "string",
            "minLength": 1
          },
          "jobs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category_code",
                "grade_scope",
                "occupation",
                "track_id"
              ],
              "properties": {
                "category_code": {
                  "type": "string",
                  "pattern": "^postal-[a-z0-9-]+$"
                },
                "grade_scope": {
                  "enum": [
                    "營運職",
                    "專業職(一)",
                    "專業職(二)內勤",
                    "專業職(二)外勤"
                  ]
                },
                "occupation": {
                  "type": "string",
                  "minLength": 1
                },
                "track_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              }
            }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_urls",
                "source_label",
                "source_context",
                "native_header",
                "subject_name_raw",
                "slot",
                "file_type",
                "checksum",
                "applies_to",
                "answer_notes"
              ],
              "properties": {
                "source_urls": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://svc\\.tabf\\.org\\.tw/_File/Download/[^#]+/HistoryPaper/[^#]+\\.pdf$"
                  },
                  "uniqueItems": true
                },
                "source_label": {
                  "type": "string",
                  "minLength": 1
                },
                "source_context": {
                  "type": "string",
                  "minLength": 1
                },
                "native_header": {
                  "type": "string",
                  "minLength": 1
                },
                "subject_name_raw": {
                  "type": "string",
                  "minLength": 1
                },
                "slot": {
                  "enum": [
                    "common",
                    "common-1",
                    "common-2",
                    "common-3",
                    "professional-1",
                    "professional-2"
                  ]
                },
                "file_type": {
                  "enum": [
                    "question",
                    "question_answer"
                  ]
                },
                "checksum": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "applies_to": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "uniqueItems": true
                },
                "answer_notes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tw-exam.invalid/schemas/post-native-papers-v1.schema.json",
  "title": "Reviewed postal native employment grades, jobs and annual papers"
}
